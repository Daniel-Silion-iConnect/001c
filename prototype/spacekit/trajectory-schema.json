{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001c trajectory",
  "description": "Initial orbital state and ordered events. Units and directions are defined in docs/ORBITAL_NOTATION.md.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "epoch": {
      "type": "string",
      "format": "date-time"
    },
    "centralBody": {
      "type": "string",
      "minLength": 1
    },
    "frame": {
      "enum": [
        "ICRS",
        "ECLIPJ2000"
      ]
    },
    "initialElements": {
      "oneOf": [
        {
          "$ref": "#/$defs/keplerian"
        },
        {
          "$ref": "#/$defs/cartesian"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/burn"
          },
          {
            "$ref": "#/$defs/oberthBurn"
          },
          {
            "$ref": "#/$defs/tetherRelease"
          },
          {
            "$ref": "#/$defs/hitchhike"
          },
          {
            "$ref": "#/$defs/gravityAssist"
          }
        ]
      }
    },
    "targetAsymptotic_km_s": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "epoch",
    "centralBody",
    "frame",
    "initialElements",
    "events"
  ],
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "keplerian": {
      "type": "object",
      "properties": {
        "type": {
          "const": "keplerian"
        },
        "a": {
          "type": "number"
        },
        "e": {
          "type": "number",
          "minimum": 0
        },
        "i": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "raan": {
          "type": "number"
        },
        "argp": {
          "type": "number"
        },
        "nu": {
          "type": "number"
        },
        "M": {
          "type": "number"
        },
        "units": {
          "type": "object",
          "properties": {
            "a": {
              "enum": [
                "AU",
                "km"
              ]
            },
            "angles": {
              "const": "deg"
            }
          },
          "required": [
            "a",
            "angles"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "a",
        "e",
        "i",
        "raan",
        "argp",
        "units"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "nu": {
              "type": "number"
            }
          },
          "required": [
            "nu"
          ]
        },
        {
          "properties": {
            "M": {
              "type": "number"
            }
          },
          "required": [
            "M"
          ]
        }
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "a": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "e": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1
                }
              }
            },
            {
              "properties": {
                "a": {
                  "type": "number",
                  "exclusiveMaximum": 0
                },
                "e": {
                  "type": "number",
                  "exclusiveMinimum": 1
                }
              }
            }
          ]
        }
      ]
    },
    "cartesian": {
      "type": "object",
      "properties": {
        "type": {
          "const": "cartesian"
        },
        "r": {
          "$ref": "#/$defs/vector3"
        },
        "v": {
          "$ref": "#/$defs/vector3"
        },
        "units": {
          "type": "object",
          "properties": {
            "r": {
              "enum": [
                "AU",
                "km"
              ]
            },
            "v": {
              "const": "km/s"
            }
          },
          "required": [
            "r",
            "v"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "r",
        "v",
        "units"
      ],
      "additionalProperties": false
    },
    "burn": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "type": {
          "const": "burn"
        },
        "deltaV_km_s": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "enum": [
            "prograde",
            "retrograde",
            "radial",
            "normal"
          ]
        }
      },
      "required": [
        "type",
        "deltaV_km_s",
        "direction"
      ],
      "additionalProperties": false
    },
    "oberthBurn": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "type": {
          "const": "oberthBurn"
        },
        "deltaV_km_s": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "enum": [
            "prograde",
            "retrograde",
            "radial",
            "normal"
          ]
        },
        "perihelion_AU": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "deltaV_km_s",
        "direction",
        "perihelion_AU"
      ],
      "additionalProperties": false
    },
    "tetherRelease": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "type": {
          "const": "tetherRelease"
        },
        "deltaV_km_s": {
          "type": "number",
          "minimum": 0
        },
        "tipSpeed_km_s": {
          "type": "number",
          "minimum": 0
        },
        "tetherLength_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotationPeriod_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "massRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "direction": {
          "enum": [
            "prograde",
            "retrograde",
            "radial",
            "normal"
          ]
        },
        "location": {
          "anyOf": [
            {
              "enum": [
                "current",
                "perihelion",
                "periapsis",
                "aphelion",
                "apoapsis"
              ]
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "type",
        "direction"
      ],
      "oneOf": [
        {
          "properties": {
            "deltaV_km_s": {
              "type": "number"
            }
          },
          "required": [
            "deltaV_km_s"
          ]
        },
        {
          "properties": {
            "tipSpeed_km_s": {
              "type": "number"
            }
          },
          "required": [
            "tipSpeed_km_s"
          ]
        },
        {
          "properties": {
            "tetherLength_km": {
              "type": "number"
            },
            "rotationPeriod_s": {
              "type": "number"
            }
          },
          "required": [
            "tetherLength_km",
            "rotationPeriod_s"
          ]
        }
      ],
      "additionalProperties": false
    },
    "hitchhike": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "type": {
          "const": "hitchhike"
        },
        "deltaV_km_s": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "enum": [
            "prograde",
            "retrograde",
            "radial",
            "normal"
          ]
        }
      },
      "required": [
        "type",
        "deltaV_km_s",
        "direction"
      ],
      "additionalProperties": false
    },
    "gravityAssist": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "type": {
          "const": "gravityAssist"
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "periapsis_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "periapsisAltitude_km": {
          "type": "number",
          "minimum": 0
        },
        "turnAngle_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "deltaV_km_s": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "enum": [
            "prograde",
            "retrograde"
          ]
        },
        "location": {
          "enum": [
            "encounter",
            "current"
          ]
        },
        "side": {
          "enum": [
            "trailing",
            "leading"
          ]
        },
        "bPlaneAngle_deg": {
          "type": "number"
        },
        "mu_km3_s2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bodyRadius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bodyOrbit_AU": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "body"
      ],
      "anyOf": [
        {
          "properties": {
            "periapsis_km": {
              "type": "number"
            }
          },
          "required": [
            "periapsis_km"
          ]
        },
        {
          "properties": {
            "periapsisAltitude_km": {
              "type": "number"
            }
          },
          "required": [
            "periapsisAltitude_km"
          ]
        },
        {
          "properties": {
            "turnAngle_deg": {
              "type": "number"
            }
          },
          "required": [
            "turnAngle_deg"
          ]
        }
      ],
      "not": {
        "properties": {
          "periapsis_km": {
            "type": "number"
          },
          "periapsisAltitude_km": {
            "type": "number"
          }
        },
        "required": [
          "periapsis_km",
          "periapsisAltitude_km"
        ]
      },
      "dependentRequired": {
        "direction": [
          "deltaV_km_s"
        ]
      },
      "dependentSchemas": {
        "deltaV_km_s": {
          "anyOf": [
            {
              "properties": {
                "periapsis_km": {
                  "type": "number"
                }
              },
              "required": [
                "periapsis_km"
              ]
            },
            {
              "properties": {
                "periapsisAltitude_km": {
                  "type": "number"
                }
              },
              "required": [
                "periapsisAltitude_km"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
